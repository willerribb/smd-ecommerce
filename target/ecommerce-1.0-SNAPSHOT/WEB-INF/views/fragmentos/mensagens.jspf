<%--
    Mensagem guardada na sessão antes de um redirecionamento
    (Sessao.definirMensagem): exibida uma única vez e depois removida.
    A página precisa ter declarado a taglib "c".
--%>
<c:if test="${not empty sessionScope.mensagem}">
    <div class="alert alert-${sessionScope.tipoMensagem} alert-dismissible fade show" role="alert">
        <c:out value="${sessionScope.mensagem}"/>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
    <c:remove var="mensagem" scope="session"/>
    <c:remove var="tipoMensagem" scope="session"/>
</c:if>
