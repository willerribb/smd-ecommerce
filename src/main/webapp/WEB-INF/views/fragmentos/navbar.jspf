<%@ page pageEncoding="UTF-8" %>
<%-- navbar for every page except entrada.jsp. menuAtivo highlights the current link --%>
<c:set var="usuarioNav" value="${sessionScope.usuarioLogado}"/>

<nav class="navbar navbar-expand-lg bg-body border-bottom">
    <div class="container">
        <a class="navbar-brand fw-bold" href="${raiz}/loja">IUVe</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal" aria-controls="menuPrincipal"
                aria-expanded="false" aria-label="Abrir menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuPrincipal">
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link ${menuAtivo == 'loja' ? 'active' : ''}" href="${raiz}/loja"
                       ${menuAtivo == 'loja' ? 'aria-current="page"' : ''}>Loja</a>
                </li>
                <%-- admin links --%>
                <c:if test="${usuarioNav.admin}">
                    <li class="nav-item">
                        <a class="nav-link ${menuAtivo == 'produtos' ? 'active' : ''}" href="${raiz}/admin/produtos"
                           ${menuAtivo == 'produtos' ? 'aria-current="page"' : ''}>Produtos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ${menuAtivo == 'categorias' ? 'active' : ''}" href="${raiz}/admin/categorias"
                           ${menuAtivo == 'categorias' ? 'aria-current="page"' : ''}>Categorias</a>
                    </li>
                </c:if>
            </ul>

            <c:choose>
                <c:when test="${not empty usuarioNav}">
                    <div class="dropdown">
                        <button class="btn d-flex align-items-center gap-2 dropdown-toggle border-0"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                                 fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                            </svg>
                            <span class="d-flex flex-column align-items-start lh-sm">
                                <span>Olá, <c:out value="${usuarioNav.primeiroNome}"/></span>
                                <c:if test="${usuarioNav.admin}">
                                    <span class="badge text-bg-dark mt-1">ADMIN</span>
                                </c:if>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="${raiz}/minha-conta">Minha conta</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form action="${raiz}/logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item">Sair</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </c:when>

                <c:otherwise>
                    <%-- current page, to come back to it after login --%>
                    <c:set var="destinoLogin" value="${requestScope['javax.servlet.forward.request_uri']}"/>
                    <c:if test="${not empty requestScope['javax.servlet.forward.query_string']}">
                        <c:set var="destinoLogin"
                               value="${destinoLogin}?${requestScope['javax.servlet.forward.query_string']}"/>
                    </c:if>

                    <div class="dropdown dropdown-entrar">
                        <button type="button" class="btn btn-primary dropdown-toggle"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                data-bs-display="static" aria-expanded="false">
                            Entrar
                        </button>
                        <div class="dropdown-menu dropdown-menu-lg-end p-4">
                            <%@ include file="/WEB-INF/views/fragmentos/form-login.jspf" %>

                            <%-- a GET form builds the ?destino= by itself; c:url could add ;jsessionid to the link --%>
                            <form action="${raiz}/cadastro" method="get" class="small mt-3 mb-0">
                                <input type="hidden" name="destino" value="<c:out value='${destinoLogin}'/>">
                                Ainda não criou uma conta?
                                <button type="submit" class="btn btn-link p-0 align-baseline">Criar conta</button>
                            </form>
                        </div>
                    </div>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</nav>