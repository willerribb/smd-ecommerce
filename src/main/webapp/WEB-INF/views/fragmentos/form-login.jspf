<%@ page pageEncoding="UTF-8" %>
<%--
    Formulário de login, usado na página de entrada e no dropdown "Entrar" da navbar.
    Antes do include, a página pode definir:
      destinoLogin  para onde ir depois de entrar (vazio: a loja, pelo Navegacao.destinoSeguro)
      valoresLogin  valores para preencher depois de um erro (só o nome de usuário)

    Os ids têm nomes próprios porque este formulário aparece na navbar de qualquer
    página, e nomes genéricos já são usados em outras (o minha-conta.jsp tem id="login").

    "Esqueci minha senha" fica para depois: exige envio de e-mail e um token com
    validade guardado no banco. O link entraria entre o campo de senha e o botão.
--%>
<form action="${raiz}/login" method="post" class="needs-validation" novalidate>
    <input type="hidden" name="destino" value="<c:out value='${destinoLogin}'/>">

    <div class="mb-3">
        <label for="loginUsername" class="form-label">Nome de usuário</label>
        <input type="text" class="form-control" id="loginUsername" name="login"
               value="<c:out value='${valoresLogin.login}'/>"
               autocomplete="username" autocapitalize="none" spellcheck="false" required>
        <div class="invalid-feedback">Informe seu nome de usuário.</div>
    </div>
    <div class="mb-4">
        <label for="loginPassword" class="form-label">Senha</label>
        <div class="campo-senha">
            <input type="password" class="form-control" id="loginPassword" name="senha"
                   autocomplete="current-password" required>
            <c:set var="campoSenha" value="loginPassword"/>
            <%@ include file="/WEB-INF/views/fragmentos/botao-senha.jspf" %>
            <div class="invalid-feedback">Informe sua senha.</div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary w-100">Entrar</button>
</form>
