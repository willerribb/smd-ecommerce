// IUVe on github codespaces: instalar.sh runs once, iniciar.sh on every start.
// the site opens in a new tab (or PORTS tab, port 8080)
{
    "name": "IUVe",

    // java 21, debian 12
    "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",

    // java is already in the image, this only adds maven
    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "none",
            "installMaven": "true",
            "installGradle": "false"
        }
    },

    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": {
            "label": "IUVe (Tomcat)",
            "onAutoForward": "openBrowser"
        }
    },

    "postCreateCommand": "bash .devcontainer/instalar.sh",
    "postStartCommand": "bash .devcontainer/iniciar.sh"
}